{
  "name": "devflow",
  "version": "2.4.0",
  "description": "DevFlow: 意图锚定 · 独立验证 · 独立审查 · 交付守门。主线程直接实现；verifier 判「按标准做完了吗」，reviewer 判「代码本身行不行」；人只在方案冻结与交付确认两个 Gate 拍板，PR 永不自动合并；适配任意 git 仓库。",
  "author": {
    "name": "starme",
    "url": "https://github.com/starme"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/devflow-hook.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/devflow-hook.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/devflow-hook.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/core/hooks/redline-guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/core/hooks/redline-guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/core/hooks/audit-log.py",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
