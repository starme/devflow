# DevFlow CI — template, not active.
#
# `.github/**` is on the DevFlow redline protected list, so an agent cannot
# install this file. Copy it to `.github/workflows/python-ci.yml` to enable.
#
# The commands mirror `scripts/check.sh`, which is the same gate run locally;
# if you change one, change both.

name: Python CI

on:
  pull_request:
  push:
    branches: ["main"]

jobs:
  check:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        python-version: ["3.10", "3.12"]
    steps:
      - uses: actions/checkout@v4

      - name: Install uv
        uses: astral-sh/setup-uv@v5
        with:
          enable-cache: true

      - name: Set up Python
        run: uv python install ${{ matrix.python-version }}

      - name: Install toolchain
        run: uv pip install --system ruff mypy

      - name: Lint
        run: |
          ruff check .
          ruff format --check .

      - name: Type check
        run: mypy

      - name: Test
        run: |
          python -m unittest discover -s core/tests
          python -m unittest discover -s adapters/codex/tests
